# ==============================================================================
# Distributed AI Software Development Platform - Environment Configuration Template
# Dağıtık Yapay Zeka Yazılım Geliştirme Platformu - Ortam Değişkenleri Şablonu
# ==============================================================================
# KULLANIM:
# Bu dosyayı '.env' olarak kopyalayın ve kendi yerel çalışma ortamınıza göre düzenleyin:
# Windows (PowerShell): Copy-Item .env.example .env
# Linux/macOS:          cp .env.example .env
#
# DİKKAT: .env dosyası hassas veriler içerebileceğinden asla git'e push edilmemelidir.
# (.gitignore içerisinde '.env' zaten hariç tutulmuştur.)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. YEREL OLLAMA MODEL SUNUCUSU (Local Ollama Engine)
# ------------------------------------------------------------------------------
# Yerel Ollama sunucusunun adresi (Varsayılan: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Master Agent gereksinim ayrıştırma için kullanılan varsayılan yerel model etiketi
OLLAMA_MODEL=qwen2.5:7b

# Ollama HTTP istek zaman aşımı süresi (saniye cinsinden)
OLLAMA_TIMEOUT=180

# ------------------------------------------------------------------------------
# 2. BULUT API YAPILANDIRMASI (İsteğe Bağlı / Secondary Cloud API)
# ------------------------------------------------------------------------------
# Bulut modeli yedek/karşılaştırma amaçlı kullanılmak istendiğinde tanımlanır.
# Yerel model çalışıyorsa veya boş bırakılırsa sistem otomatik olarak yerel kipi kullanır.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. GÜVENLİ YEDEK / TANITIM KİPİ (Safe Fallback / Demo Mode)
# ------------------------------------------------------------------------------
# Model sunucusu kapalıyken, bağlantı koptuğunda veya kota (429) aşıldığında
# sistemin çökmeden etiketlenmiş yedek şablon kipine geçmesini sağlar.
FALLBACK_ENABLED=true

# ------------------------------------------------------------------------------
# 4. BACKEND API & WORKER AJAN DAĞITIK İLETİŞİM AĞI (Sprint 2 & 3 REST API)
# ------------------------------------------------------------------------------
# İrem Yılmaz (Backend Agent) tarafından sunulan ana servis uç noktası
BACKEND_API_HOST=http://localhost:8000
BACKEND_API_PORT=8000

# Dağıtık ajanların Master/Backend servisine bağlanırken kullanacağı yetkilendirme anahtarı
BACKEND_AUTH_TOKEN=change-this-secure-token-in-production

# ------------------------------------------------------------------------------
# 5. TESTING AGENT (S3-06 — Berat İnan, deepseek-coder:6.7b)
# ------------------------------------------------------------------------------
# false yapılırsa TestingAgent Ollama'yı çağırmaz, etiketli şablon çıktı döner (CI / hızlı demo)
TESTING_AGENT_USE_OLLAMA=true
# Boş bırakılırsa üretilen testler yalnızca output_artifacts içinde döner, diske yazılmaz.
# Doluysa dosyalar bu dizinin içine yazılır (../ yol geçişi engellenir).
TESTING_AGENT_OUTPUT_DIR=

# Worker HTTP testleri (tests/test_worker_http.py). Sunucu kapalıysa testler atlanır.
# Token için WORKER_AUTH_TOKEN boşsa BACKEND_AUTH_TOKEN kullanılır.
WORKER_BASE_URL=http://localhost:8000
WORKER_TASK_PATH=/task
WORKER_HEALTH_PATH=/health
